custom_dataset: !function utils.load_edrac_dialect
test_split: test

output_type: generate_until
num_fewshot: 0

# With --apply_chat_template, lm-eval renders the description as the system
# message and doc_to_text as the user message, matching the official setup.
description: "Given the following passage, answer the accompanying questions.\n"
doc_to_text: !function utils.doc_to_text
doc_to_target: !function utils.doc_to_target
target_delimiter: ""

metric_list:
  - metric: !function utils.rouge_l
    aggregation: !function utils.rouge_l_aggregate
    higher_is_better: true

generation_kwargs:
  until:
    - <end_of_turn>
    - <eos>
    - </s>
    - <|end_of_text|>
    - <|eot_id|>
    - <|endoftext|>
    - <|im_end|>
  max_gen_toks: 256
  do_sample: false
  temperature: 0.0
  top_p: 1.0
  repetition_penalty: 1.0

metadata:
  version: 1.0

