# FLORES+ devtest (openlanguagedata/flores_plus, gated) pivoted to one row per id by utils.py
custom_dataset: !function utils.load_flores_devtest
test_split: test

output_type: generate_until
generation_kwargs:
  until:
    - "<end_of_turn>"
    - "<eos>"
    - "</s>"
    - "<|end_of_text|>"
    - "<|eot_id|>"
    - "<|endoftext|>"
    - "<|im_end|>"
  do_sample: false
  temperature: 0.0

metric_list:
  - metric: bleu
    aggregation: bleu
    higher_is_better: true
  - metric: spbleu
    aggregation: spbleu
    higher_is_better: true
  - metric: chrfpp
    aggregation: chrfpp
    higher_is_better: true

metadata:
  version: 0.0
